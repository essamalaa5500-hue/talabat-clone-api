model OrderItemOption {
  id          String    @id @default(uuid())
  orderItemId String
  optionName  String
  extraPrice  Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
}
